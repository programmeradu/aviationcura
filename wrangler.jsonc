{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aviation-curator",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./frontend/dist"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 */3 * * *"
		]
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"workflows": [
		{
			"name": "aviation-curator-workflow",
			"binding": "MY_WORKFLOW",
			"class_name": "AviationCuratorWorkflow"
		}
	],
	"r2_buckets": [
		{
			"binding": "VIDEOS_BUCKET",
			"bucket_name": "aviation-videos"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aviation-curator-db",
			"database_id": "891c3361-394e-401f-b1fd-c8262d916fca"
		}
	],
	"containers": [
		{
			"class_name": "ObfuscatorContainer",
			"image": "./video-obfuscator/Dockerfile",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ObfuscatorContainer",
				"name": "OBFUSCATOR"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"ObfuscatorContainer"
			],
			"tag": "v1"
		}
	]
}